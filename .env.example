# Deskwire environment variables
#
# Source of truth is the Vercel dashboard, maintained per environment
# (Production / Preview / Development). Never put real values in this file.
#
# Local development:
#   npx vercel link        # once: link this repo to the Vercel project
#   npx vercel env pull    # writes .env.local (gitignored)
#
# Convention: every variable the app reads is documented here (name plus a
# short comment, no value) in the same task that introduces it.
#
# --- Sentry (task 3) ---

# Public DSN (safe to expose). Set in all Vercel environments.
NEXT_PUBLIC_SENTRY_DSN=

# Source map upload during the Vercel build. Production + Preview only,
# marked Sensitive. Never set locally or in CI; the build passes without it
# and only skips the upload.
SENTRY_AUTH_TOKEN=

# Set to 1 to enable the test error route /api/debug-sentry. Only set it
# temporarily (usually Preview) to verify the Sentry wiring, remove afterwards.
DEBUG_SENTRY_ENABLED=

# --- Database (task 4) ---

# Pooled Neon connection string, the only variable app code reads (via
# src/lib/env.ts). Managed by the Neon Vercel integration: set in Production,
# injected per branch into Preview deployments. Locally from the Neon
# onboarding .env or `npx vercel env pull`.
DATABASE_URL=

# Direct (unpooled) connection string. Used exclusively by drizzle-kit
# (db:generate/db:migrate/db:studio), never by app code.
DATABASE_URL_UNPOOLED=

# Written by the Neon onboarding into the local .env, currently unused.
NEON_BRANCH=
