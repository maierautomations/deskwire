# Deskwire environment variables
#
# Source of truth is the Vercel dashboard, maintained per environment
# (Production / Preview / Development). Never put real values in this file.
#
# Local development:
#   npx vercel link        # once: link this repo to the Vercel project
#   npx vercel env pull    # writes .env.local (gitignored)
#
# Convention: every variable the app reads is documented here (name plus a
# short comment, no value) in the same task that introduces it.
#
# Platform-provided variables (VERCEL, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV,
# VERCEL_GIT_COMMIT_SHA, NEXT_RUNTIME, NODE_ENV, CI) are also read by the
# code but set by Vercel/Next/CI themselves; they are deliberately not
# listed below and never configured by hand.
#
# --- Sentry (task 3) ---

# Public DSN (safe to expose). Set in all Vercel environments.
NEXT_PUBLIC_SENTRY_DSN=

# Source map upload during the Vercel build. Production + Preview only,
# marked Sensitive. Never set locally or in CI; the build passes without it
# and only skips the upload.
SENTRY_AUTH_TOKEN=

# Set to 1 to enable the test error route /api/debug-sentry. Only set it
# temporarily (usually Preview) to verify the Sentry wiring, remove afterwards.
DEBUG_SENTRY_ENABLED=

# --- Database (task 4) ---

# Pooled Neon connection string, the only variable app code reads (via
# src/lib/env.ts). Managed by the Neon Vercel integration: set in Production,
# injected per branch into Preview deployments. Locally from the Neon
# onboarding .env or `npx vercel env pull`.
DATABASE_URL=

# Direct (unpooled) connection string. Used exclusively by drizzle-kit
# (db:generate/db:migrate/db:studio), never by app code.
DATABASE_URL_UNPOOLED=

# Written by the Neon onboarding into the local .env, currently unused.
NEON_BRANCH=

# --- Auth.js (task 7a) ---
#
# Never set AUTH_URL (in Vercel or locally): Auth.js v5 derives all URLs from
# the request host (trustHost), which keeps magic links pointing at the exact
# deployment, including every preview URL.

# Session/token secret, generated per environment: openssl rand -base64 32
AUTH_SECRET=

# Resend API key with sending access, used for magic-link mails.
AUTH_RESEND_KEY=

# Sender address ("Name <address>" allowed). Sandbox until a domain is
# verified: onboarding@resend.dev, which only delivers to the Resend
# signup address.
EMAIL_FROM=

# --- Upstash Ratelimit (task 9) ---
#
# REST credentials of the deskwire-ratelimit Redis DB (Frankfurt,
# eu-central-1). Read directly by Redis.fromEnv() inside a try/catch:
# missing or broken values disable the magic-link rate limiter (fail-open,
# defense in depth, one Sentry warning per process) and never break login.
# Set in all Vercel environments. Never required in CI or tests.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (tasks 14/15a) ---
#
# Both Stripe secrets live ONLY in the Vercel Production scope; Preview
# deliberately has none (no preview webhooks in phase 0). That is why both
# fields stay OPTIONAL in serverEnv(): required fields would break every
# preview deployment at env validation (health 503, login dead). Fail-closed
# lives in getStripe() and in the webhook route guard instead. Leave them
# UNSET rather than empty: an empty string counts as a config error and
# breaks serverEnv() loudly, absence is the only valid "not set" state.

# Test-mode secret key (sk_test_...). Vercel Production and .env.local only.
# getStripe() throws with a clear error while it is missing.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...). The webhook route answers 500 before
# any constructEvent call while it is missing. Two different secrets exist
# and are not interchangeable: `stripe listen` prints the CLI secret (only
# valid for the local forwarding, -> .env.local), the dashboard webhook
# endpoint has its own (only valid for deliveries to the prod URL,
# -> Vercel Production). Mixed up, the route answers a silent 400 without
# a Sentry event; diagnose via the endpoint's delivery view in the Stripe
# dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Dev-Log-Login (task 7b) ---

# Set to 1 to print magic links to the local server log instead of sending
# mail (second-user tests despite the Resend sandbox). Guarded by code: only
# active when NODE_ENV is development AND no VERCEL variable is set. Never
# set this in Vercel; it would be ignored there, but it does not belong in
# any dashboard.
AUTH_EMAIL_DEV_LOG=
